{
  "name": "radio-shack",
  "version": "0.1.0",
  "description": "Online radio station prototype",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "npm run css:build && node server.js",
    "dev": "concurrently -n css,srv -c cyan,green \"npm:css:watch\" \"nodemon server.js\"",
    "db:init": "node db/init.js",
    "css:build": "tailwindcss -i src/input.css -o public/style.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o public/style.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^4.21.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
